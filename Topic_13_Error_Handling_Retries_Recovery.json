    },
    {
      "parameters": {
        "jsCode": "const incident = $input.item.json;\nreturn {\n  json: {\n    recoveryAction: \"PERMANENT_INCIDENT_ESCALATED\",\n    dlqId: incident.dlqId,\n    incidentId: incident.incidentId,\n    priority: \"P1_URGENT\",\n    targetChannel: \"#sre-escalations\",\n    recommendation: \"Permanent schema or credential fault: Do not retry automatically.\",\n    escalatedAt: new Date().toISOString()\n  }\n};"
      },
