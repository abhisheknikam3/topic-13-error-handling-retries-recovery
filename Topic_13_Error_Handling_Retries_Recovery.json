      "parameters": {
        "jsCode": "const incident = $input.item.json;\nreturn {\n  json: {\n    recoveryAction: \"REPLAY_DISPATCHED\",\n    dlqId: incident.dlqId,\n    incidentId: incident.incidentId,\n    replayEndpoint: \"https://dummyjson.com/c/mock-payment-replay\",\n    scheduledDelaySeconds: 5,\n    replayedPayload: incident.stagedPayload,\n    replayedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "e9a10001-0008-4000-8000-000000000008",
      "name": "Code_ScheduleReplay",
