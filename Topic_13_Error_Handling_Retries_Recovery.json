      "position": [
        200,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const errorContext = $input.first().json;\nconst execution = errorContext.execution || {};\nconst lastNode = execution.error?.node || {};\nconst failedItem = lastNode.runIndex !== undefined \n  ? execution.data?.resultData?.runData?.[lastNode.name]?.[0]?.data?.main?.[0]?.[0]?.json \n  : { transactionId: \"TX-CRASH-801\", customerEmail: \"vip-client@enterprise.org\", amount: 1450.00 };\n\nconst statusCode = execution.error?.statusCode || 504;\nconst isTransient = [502, 503, 504, 429].includes(statusCode);\n\nreturn [{\n  json: {\n    incidentId: \"INC-\" + Math.random().toString(36).substring(2, 9).toUpperCase(),\n    workflowId: $workflow.id,\n    workflowName: $workflow.name,\n    failedNodeName: lastNode.name || \"HTTP_FlakyPaymentGateway\",\n    errorMessage: execution.error?.message || \"504 Gateway Timeout: Upstream provider latency exceeded SLA\",\n    httpStatusCode: statusCode,\n    isTransientFault: isTransient,\n    recoveryCategory: isTransient ? \"AUTOMATED_REPLAY\" : \"MANUAL_INVESTIGATION\",\n    stagedPayload: failedItem,\n    capturedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "e9a10001-0005-4000-8000-000000000005",
      "name": "Code_ExtractDiagnostics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.dlqRecords = staticData.dlqRecords || [];\nconst incident = $input.item.json;\n\nconst dlqEntry = {\n  dlqId: \"DLQ-\" + Date.now(),\n  incidentId: incident.incidentId,\n  failedNode: incident.failedNodeName,\n  payload: incident.stagedPayload,\n  error: incident.errorMessage,\n  status: \"QUEUED_IN_DLQ\",\n  replayCount: 0,\n  timestamp: new Date().toISOString()\n};\nstaticData.dlqRecords.push(dlqEntry);\n\nreturn {\n  json: {\n    ...incident,\n    dlqId: dlqEntry.dlqId,\n    dlqStored: true\n  }\n};"
      },
      "id": "e9a10001-0006-4000-8000-000000000006",
      "name": "Code_PersistToDLQ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
